# Phase 2 — fill real Supabase values to enable live mode
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for /t/[token] HMAC verification
TABLE_QR_HMAC_SECRET=replace-with-32-char-random-secret

# Optional dedicated Member Pass HMAC (falls back to TABLE_QR_HMAC_SECRET)
MEMBER_PASS_HMAC_SECRET=replace-with-32-char-pass-secret

# AES-256-GCM key material for system_configs secrets (falls back to TABLE_QR_HMAC_SECRET)
CONFIG_ENCRYPTION_KEY=replace-with-32-char-config-secret

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100

# Payments — razorpay | cashfree | sandbox | auto
PAYMENT_PROVIDER=sandbox
PAYMENT_GATEWAY_MICRO_HOLD_AMOUNT=1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox

GEO_FENCE_EXIT_METERS=50
GEO_FENCE_EXIT_SUSTAIN_MS=180000
ANTI_CANNIBALIZATION_RADIUS_M=1500
ANTI_CANNIBALIZATION_LOCKOUT_MIN=60

# Public venue demo logins (after supabase/seed.sql):
# club@maitab.demo / gate@maitab.demo / bar@maitab.demo
# av@maitab.demo / rahul@maitab.demo
# Password: MaiTabDemo!234
# Super Admin is NOT listed on /login — unlock via /admin/super-portal only.

# Internal Super Admin unlock (min 16 chars; never commit real values)
SUPER_ADMIN_PORTAL_KEY=replace-with-16plus-char-portal-key
# Optional JWT credentials for Super Admin (env only — never hardcode in UI)
SUPER_ADMIN_DEMO_EMAIL=
SUPER_ADMIN_DEMO_PASSWORD=
# Comma-separated Google emails with sovereign Super Admin access
SUPER_ADMIN_EMAILS=
# Optional vault 2FA PIN for /super-admin-vault (local default 4829 in development)
SUPER_ADMIN_VAULT_PIN=
